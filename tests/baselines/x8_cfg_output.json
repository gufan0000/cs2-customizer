    "viewmodel 预设两条": {
      "冲突": [],
      "正文": [
        "// CS2 Customizer CFG配置文件 (auto-generated)",
        "",
        "// -- Viewmodel Settings (CS2Customizer) --",
        "",
        "// == Viewmodel Presets ==",
        "alias viewmodel_1 \"viewmodel_offset_x 2; viewmodel_offset_y 2; viewmodel_offset_z -1; viewmodel_fov 68; echo hi\"",
        "bind F1 viewmodel_1",
        "alias viewmodel_2 \"viewmodel_offset_x 1; viewmodel_offset_y 1; viewmodel_offset_z -2; viewmodel_fov 60; echo lo\"",
        "bind F2 viewmodel_2",
        "",
        "// Cycle switch",
        "alias viewmodel_cycle viewmodel_cycle_1",
        "alias viewmodel_cycle_1 \"viewmodel_1; alias viewmodel_cycle viewmodel_cycle_2\"",
        "alias viewmodel_cycle_2 \"viewmodel_2; alias viewmodel_cycle viewmodel_cycle_1\"",
        "bind CAPSLOCK viewmodel_cycle",
        "",
        "// -- HUD Rules Begin (CS2Customizer) --",
        "cl_hud_color 0",
        "alias +fp_hud_w \"+forward; exec cs2customizer_hud_runtime.cfg\"",
        "alias -fp_hud_w \"-forward; exec cs2customizer_hud_runtime.cfg\"",
        "bind w +fp_hud_w",
        "alias +fp_hud_s \"+back; exec cs2customizer_hud_runtime.cfg\"",
        "alias -fp_hud_s \"-back; exec cs2customizer_hud_runtime.cfg\"",
        "bind s +fp_hud_s",
        "alias +fp_hud_a \"+left; exec cs2customizer_hud_runtime.cfg\"",
        "alias -fp_hud_a \"-left; exec cs2customizer_hud_runtime.cfg\"",
        "bind a +fp_hud_a",
        "alias +fp_hud_d \"+right; exec cs2customizer_hud_runtime.cfg\"",
        "alias -fp_hud_d \"-right; exec cs2customizer_hud_runtime.cfg\"",
        "bind d +fp_hud_d",
        "alias +quickrepos_attack \"+attack; exec cs2customizer_hud_runtime.cfg\"",
        "alias -quickrepos_attack \"-attack; exec cs2customizer_hud_runtime.cfg\"",
        "bind mouse1 +quickrepos_attack",
        "alias +quickrepos_attack2 \"+attack2\"",
        "alias -quickrepos_attack2 \"-attack2\"",
        "alias +fp_hud_mouse1 \"+attack; exec cs2customizer_hud_runtime.cfg\"",
        "alias -fp_hud_mouse1 \"-attack; exec cs2customizer_hud_runtime.cfg\"",
        "// -- HUD Rules End (CS2Customizer) --",
        "",
        "echo \"CS2 Customizer CFG配置文件已加载\""
      ],
      "行数": 40
    },
