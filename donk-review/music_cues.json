{
  "file": "music/yu_chunyang.m4a",
  "segments": [
    {
      "start": 18.640000000000004,
      "end": 19.38,
      "text": "Zither Harp"
    },
    {
      "start": 30.0,
      "end": 34.1,
      "text": "你仍恰 恰似当年孤立成飞火"
    },
    {
      "start": 35.2,
      "end": 37.9,
      "text": "醉薄风 喝过茶"
    },
    {
      "start": 38.72,
      "end": 41.66,
      "text": "寻常巷口 寻个酒家"
    },
    {
      "start": 42.480000000000004,
      "end": 44.22,
      "text": "在错节酸老悠"
    },
    {
      "start": 45.7,
      "end": 48.8,
      "text": "万地别是平洋"
    },
    {
      "start": 50.68,
      "end": 53.8,
      "text": "黑牙重不重不为家"
    },
    {
      "start": 54.44,
      "end": 56.86,
      "text": "我们在我也像广山"
    },
    {
      "start": 58.26,
      "end": 64.16,
      "text": "转移不及躲过 斩散分离 看似真微笑"
    },
    {
      "start": 64.82000000000001,
      "end": 71.6,
      "text": "倒何处 却眼上 偶尔陷害 温哥伤伤"
    },
    {
      "start": 71.6,
      "end": 77.36,
      "text": "没提 是我愿回忆了些九十滴酒家"
    },
    {
      "start": 79.16000000000001,
      "end": 83.06,
      "text": "向前门折磨 堆塞风雨荒落"
    },
    {
      "start": 83.06,
      "end": 86.6,
      "text": "歌琴琴散磨 荒流来殿下"
    },
    {
      "start": 86.6,
      "end": 90.42,
      "text": "人世可相逢 知己心有期盼"
    },
    {
      "start": 90.42,
      "end": 94.14,
      "text": "要我排看雪君的言文都言小"
    },
    {
      "start": 94.14,
      "end": 97.84,
      "text": "向前背影过大 堆塞风雨荒沙"
    },
    {
      "start": 97.84,
      "end": 101.6,
      "text": "无情也散磨 向前递斩头火"
    },
    {
      "start": 101.6,
      "end": 105.5,
      "text": "人世难相逢 解情深脆白霸"
    },
    {
      "start": 105.5,
      "end": 109.74,
      "text": "慷慨微霜雪香 藏白剑一頭花"
    },
    {
      "start": 112.52000000000001,
      "end": 115.7,
      "text": "過散尋求其看月花"
    },
    {
      "start": 115.7,
      "end": 118.5,
      "text": "冷醉的烏根不換甲"
    },
    {
      "start": 119.38,
      "end": 123.14,
      "text": "溫說到夢下少年時"
    },
    {
      "start": 123.14,
      "end": 126.24,
      "text": "甘誇於的抱歉竟存嗎"
    },
    {
      "start": 126.24,
      "end": 129.98,
      "text": "你心似真生活"
    },
    {
      "start": 129.98,
      "end": 133.32,
      "text": "就我草葉比神仙塌"
    },
    {
      "start": 133.98,
      "end": 140.12,
      "text": "教育人已奈背 灿烂不及动向"
    },
    {
      "start": 142.68,
      "end": 148.64,
      "text": "曾动向好几位层吧 在地里尽风出情话"
    },
    {
      "start": 150.18,
      "end": 156.32,
      "text": "本来人寻见谁似我 将日夜深海一丁相纳"
    },
    {
      "start": 156.32,
      "end": 160.36,
      "text": "只性命不作答"
    },
    {
      "start": 160.36,
      "end": 163.64,
      "text": "转身相遇外几生压"
    },
    {
      "start": 164.32,
      "end": 166.0,
      "text": "不必说明会"
    },
    {
      "start": 166.0,
      "end": 169.26,
      "text": "既然隔空是地球家"
    },
    {
      "start": 170.82000000000002,
      "end": 172.9,
      "text": "像丧男中的花"
    },
    {
      "start": 172.9,
      "end": 174.84,
      "text": "对春风的红额"
    },
    {
      "start": 174.84,
      "end": 178.46,
      "text": "多情丛似我红柳来天下"
    },
    {
      "start": 178.46,
      "end": 180.3,
      "text": "人世可相逢"
    },
    {
      "start": 180.3,
      "end": 182.24,
      "text": "只见星星光"
    },
    {
      "start": 182.24,
      "end": 186.0,
      "text": "有我改变却醉烟温都烟霞"
    },
    {
      "start": 186.0,
      "end": 188.04,
      "text": "将将悲伤不放"
    },
    {
      "start": 188.04,
      "end": 189.8,
      "text": "对戏碰晃杀"
    },
    {
      "start": 189.8,
      "end": 193.54,
      "text": "无情脸似我隐倦风斩刀花"
    },
    {
      "start": 193.54,
      "end": 195.6,
      "text": "人世能相逢"
    },
    {
      "start": 195.6,
      "end": 197.28,
      "text": "随情善罪百搬"
    },
    {
      "start": 197.28,
      "end": 199.42,
      "text": "慷慨为数许相分"
    },
    {
      "start": 199.42,
      "end": 201.4,
      "text": "每千亿刀花"
    },
    {
      "start": 201.4,
      "end": 204.72,
      "text": "当此时输赢都算鲜花"
    },
    {
      "start": 204.72,
      "end": 208.4,
      "text": "来换杯成酒添汤我潇洒"
    },
    {
      "start": 208.4,
      "end": 212.24,
      "text": "朋友不自老 谈假成昨年华"
    },
    {
      "start": 212.24,
      "end": 216.14,
      "text": "陪我走马去 过过前提 背中你生涯"
    },
    {
      "start": 216.14,
      "end": 219.76,
      "text": "当此时 伤死也损险化"
    },
    {
      "start": 219.76,
      "end": 223.34,
      "text": "来换成好 再不负天走 潇洒"
    },
    {
      "start": 223.34,
      "end": 227.24,
      "text": "朋友不自老 谈假成昨年华"
    },
    {
      "start": 227.24,
      "end": 231.08,
      "text": "陪我自由去 只做工人不微笑"
    }
  ],
  "tempo": 129.19921875,
