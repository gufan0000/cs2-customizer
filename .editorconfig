# https://editorconfig.org
# 与 .gitattributes 保持一致：仓库内文本统一 LF，Windows 批处理保持 CRLF。
# 两个文件都要有——.gitattributes 管的是 git 存/取时的转换，
# .editorconfig 管的是编辑器**新写入**时用什么行尾。少一个就会出现
# "提交前本地是 CRLF、提交后变 LF"的反复噪音。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
# Markdown 里行尾两个空格是有语义的（强制换行），不能剪
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.iss]
# Inno Setup 脚本：Windows 工具链，保持 CRLF
end_of_line = crlf
