# 帆派助手 — 行尾规范化 (防止 CRLF/LF 噪音再次污染 diff)
# 仓库内所有文本文件统一 LF；二进制资源标记为 binary 不做转换。

* text=auto eol=lf

# 源码与文本
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.cfg   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.spec  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
requirements*.txt text eol=lf

# Windows 批处理保持 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制资源 — 不做行尾转换
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.bmp   binary
*.svg   binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.flac  binary
*.mp4   binary
*.zip   binary
*.exe   binary
*.dll   binary
*.ttf   binary
*.otf   binary
*.pdf   binary
